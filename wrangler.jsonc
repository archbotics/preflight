{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "preflight",
  "main": "src/index.js",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/r/*"],
    "not_found_handling": "404-page"
  },
  "durable_objects": {"bindings": [{"name": "CONTROL", "class_name": "Control"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["Control"]}],
  "ratelimits": [
    {"name": "WRITE_LIMITER", "namespace_id": "21201", "simple": {"limit": 6, "period": 60}},
    {"name": "READ_LIMITER", "namespace_id": "21202", "simple": {"limit": 60, "period": 60}}
  ],
  "vars": {"DAILY_SCAN_LIMIT": "250", "SERVICE_ENABLED": "true"},
  "limits": {"cpu_ms": 100},
  "observability": {"enabled": false}
}
